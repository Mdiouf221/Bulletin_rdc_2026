   <dc:subject>
    <rdf:Bag>
     <rdf:li>Cash for assets</rdf:li>
     <rdf:li>Climate Change</rdf:li>
     <rdf:li>Crop field</rdf:li>
     <rdf:li>Farmer</rdf:li>
     <rdf:li>Food for Assets</rdf:li>
     <rdf:li>Looking at Camera</rdf:li>
     <rdf:li>Planting</rdf:li>
